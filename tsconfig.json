{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./apps/creator/src/*"] }
  },
  "include": [
    "apps/creator/next-env.d.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "apps/creator/.next/types/**/*.ts",
    "apps/creator/.next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "**/node_modules"]
}
