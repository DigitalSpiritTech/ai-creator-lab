{
  "workflow": "minimax-h3-i2v.api.json",
  "capability": "image_to_video",
  "openWeights": true,
  "maxReferences": 1,
  "outputNode": "1",
  "slots": {
    "prompt": {
      "node": "15",
      "input": "prompt"
    },
    "width": {
      "node": "15",
      "input": "width"
    },
    "height": {
      "node": "15",
      "input": "height"
    },
    "length": {
      "node": "15",
      "input": "length"
    },
    "seed": {
      "node": "13",
      "input": "noise_seed"
    },
    "image1": {
      "node": "2",
      "input": "image",
      "kind": "image"
    }
  },
  "limits": {
    "sizes": [
      [
        736,
        1312
      ],
      [
        1312,
        736
      ],
      [
        1024,
        1024
      ],
      [
        928,
        1152
      ]
    ],
    "multipleOf": 32,
    "length": {
      "default": 124,
      "rule": "17n+5"
    },
    "fps": 24
  },
  "notes": "MiniMax H3 image to video with sound: the still is the first frame (turbo 8-step LoRA, res_multistep), 24 fps, 17n+5 frames, from the official template. The image is center-cropped and scaled to the output size."
}
