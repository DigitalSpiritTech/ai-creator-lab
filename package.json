{
  "name": "ai-creator-lab",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node apps/creator/scripts/serve.mjs dev",
    "build": "next build apps/creator --webpack",
    "start": "node apps/creator/scripts/serve.mjs start",
    "lint": "eslint .",
    "typecheck": "next typegen apps/creator && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:acceptance": "node --import tsx apps/creator/scripts/acceptance-smoke.ts",
    "spike": "node --import tsx apps/creator/scripts/spike/run.ts",
    "spike:v02": "node --import tsx --conditions=react-server apps/creator/scripts/spike/v02.ts",
    "mcp": "node --import tsx apps/creator/scripts/mcp.ts",
    "live-check": "node --import tsx --conditions=react-server apps/creator/scripts/live-check.ts",
    "e2e-real": "node --import tsx --conditions=react-server apps/creator/scripts/e2e-real.ts",
    "live-flf": "node --import tsx --conditions=react-server apps/creator/scripts/live-flf.ts",
    "redo-clip": "node --import tsx --conditions=react-server apps/creator/scripts/redo-clip.ts",
    "e2e-photos": "node --import tsx --conditions=react-server apps/creator/scripts/e2e-photos.ts",
    "live-premium": "node --import tsx --conditions=react-server apps/creator/scripts/live-premium.ts",
    "verify-workflow": "node --import tsx --conditions=react-server apps/creator/scripts/verify-workflow.ts",
    "e2e-voice": "node --import tsx --conditions=react-server apps/creator/scripts/e2e-voice.ts",
    "gallery:build": "node --import tsx apps/creator/scripts/build-gallery.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "bin": {
    "ai-creator-lab": "apps/creator/scripts/launch.mjs"
  }
}
