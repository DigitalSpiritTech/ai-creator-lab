# Comfy API key from https://platform.comfy.org (used for Comfy Cloud, API deployments, and Router).
COMFY_API_KEY=

# Blank for Comfy Cloud. A deployment URL (https://<name>.run.comfy.app) or the local proxy (http://127.0.0.1:8189).
COMFY_BASE_URL=

# Assistant.
ANTHROPIC_API_KEY=
LLM_MODEL=

# Cumulative allowance for paid generation in USD. Zero disables every paid submission. Set this yourself; agents never do.
GENERATION_ALLOWANCE_USD=0

# Local data directory (database, media, exports). Keep the whole directory together for backups.
STUDIO_DATA_DIR=.data

# Optional explicit paths when ffmpeg and ffprobe are outside PATH.
FFMPEG_PATH=
FFPROBE_PATH=
