# Comfy API key from https://platform.comfy.org (used for Comfy Cloud, API deployments, and Router).
COMFY_API_KEY=

# Blank for Comfy Cloud. A deployment URL (https://<name>.run.comfy.app) or the local proxy (http://127.0.0.1:8189).
COMFY_BASE_URL=

# Assistant.
ANTHROPIC_API_KEY=
LLM_MODEL=
# anthropic (default) or router: router runs the assistant on Comfy Router with COMFY_API_KEY, no Anthropic key needed.
LLM_PROVIDER=

# Operator ceiling for paid generation in USD per calendar month (UTC); the monthly budget in Settings and any extension stay under it. Zero disables every paid submission. Set this yourself; agents never do.
GENERATION_ALLOWANCE_USD=0

# Local data directory (database, media, exports). Keep the whole directory together for backups.
STUDIO_DATA_DIR=.data

# Optional explicit paths when ffmpeg and ffprobe are outside PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Mock recipes (free placeholders used by the test suite) are hidden from the catalog. Set to 1 to list them.
# MOCK_RECIPES=1

# The MCP server (npm run --silent mcp) offers spending and permanent deletion only when these are set.
# MCP_ALLOW_SPEND=1
# MCP_ALLOW_DELETE=1

# Hosted (Router) requests kept open at once; the rest wait their turn. Router refuses more than a few per account.
# ROUTER_CONCURRENCY=2

# Where npm start and npm run dev listen. Unset is 127.0.0.1 (this computer only, no password). Any
# other address (0.0.0.0 for every interface) turns on the app password: the first start prints a
# one-time setup code in the server log. List the names people type in the address bar (or a reverse
# proxy's public name, which also turns the password on) in STUDIO_ALLOWED_HOSTS, comma-separated.
# HOST=0.0.0.0
# STUDIO_ALLOWED_HOSTS=studio.lan,192.168.1.20

# Read-only mode: nothing can be changed or generated, and no password is asked, so only use it on a
# data folder you would show anyone. Hosted demos add STUDIO_PUBLIC_HOST, the hostname they are
# served on. See docs/DEMO-DEPLOY.md.
# STUDIO_READ_ONLY=1
# STUDIO_PUBLIC_HOST=demo.example.com
# A private judging copy instead: every request needs this password (12+ characters), and the keys and
# GENERATION_ALLOWANCE_USD above cap what it can spend.
# STUDIO_JUDGE_PASSWORD=
